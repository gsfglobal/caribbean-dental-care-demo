# Sito pubblico (opzionale): endpoint del modulo contatti. Senza → modalità demo (richieste salvate solo nel browser).
NEXT_PUBLIC_FORM_ENDPOINT=/api/request
# Cloudflare Turnstile (antispam) — chiave pubblica del sito
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Sito definitivo
NEXT_PUBLIC_SITE_URL=https://DOMINIO-DA-CONFERMARE.example

# Solo lato server (Cloudflare Pages Functions → Settings → Environment variables). MAI nel frontend.
TURNSTILE_SECRET_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NOTIFY_EMAIL=
RESEND_API_KEY=
